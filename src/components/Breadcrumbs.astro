---
interface Props {items: {label: string; href?: string}[]; label?: string}
const {items, label='Breadcrumb'} = Astro.props;
---
<nav class="breadcrumbs" aria-label={label}>
  {items.map((item,index) => <span class="breadcrumb-part">
    {index > 0 && <span aria-hidden="true">/</span>}
    {item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
  </span>)}
</nav>
<style>
.breadcrumbs{display:flex;flex-wrap:wrap;align-items:center;gap:8px 10px;margin:0;font-size:14px;line-height:1.5;color:var(--cm-secondary)}
.breadcrumb-part{display:inline-flex;align-items:center;gap:10px;min-width:0}
.breadcrumbs a{display:inline-flex;align-items:center;min-height:44px;text-decoration:none}
.breadcrumbs a:hover{text-decoration:underline}
.breadcrumbs [aria-current]{color:var(--cm-ink)}
@media(max-width:760px){.breadcrumbs{font-size:12px}}
@media(max-width:600px){.breadcrumbs,.breadcrumb-part{gap:8px}.breadcrumbs a{min-height:36px}.breadcrumbs.is-wrapped{row-gap:0;line-height:14px}.breadcrumbs.is-wrapped a{position:relative;min-height:14px}.breadcrumbs.is-wrapped a::after{content:"";position:absolute;inset:-5px 0}}
</style>

<script>
  // Tighten actual wrapped rows. CSS extends link hit areas without adding row height.
  const breadcrumbs = document.querySelectorAll<HTMLElement>('.breadcrumbs');
  const phone = window.matchMedia('(max-width:600px)');
  let frame = 0;
  const measure = () => {
    frame = 0;
    breadcrumbs.forEach(nav => {
      const centers = Array.from(nav.children, part => {
        const rect = part.getBoundingClientRect();
        return rect.top + rect.height / 2;
      });
      nav.classList.toggle('is-wrapped', phone.matches && centers.length > 1 && Math.max(...centers) - Math.min(...centers) > 2);
    });
  };
  const schedule = () => { if (!frame) frame = requestAnimationFrame(measure); };
  const observer = new ResizeObserver(schedule);
  breadcrumbs.forEach(nav => observer.observe(nav));
  phone.addEventListener('change', schedule);
  document.fonts.ready.then(schedule);
  schedule();
</script>
