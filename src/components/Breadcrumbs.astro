---
interface Props {items: {label: string; href?: string}[]; label?: string}
const {items, label='Breadcrumb'} = Astro.props;
---
<nav class="breadcrumbs" aria-label={label}>
  {items.map((item,index) => <span class="breadcrumb-part">
    {index > 0 && <span aria-hidden="true">/</span>}
    {item.href ? <a class="cm-inline-link" href={item.href}><span class="cm-intro-link-text">{item.label}</span></a> : <span aria-current="page">{item.label}</span>}
  </span>)}
</nav>


<script>
  // Tighten actual wrapped rows. CSS extends link hit areas without adding row height.
  const breadcrumbs = document.querySelectorAll<HTMLElement>('.breadcrumbs');
  const phone = window.matchMedia('(max-width:600px)');
  let frame = 0;
  const measure = () => {
    frame = 0;
    breadcrumbs.forEach(nav => {
      const centers = Array.from(nav.children, part => {
        const rect = part.getBoundingClientRect();
        return rect.top + rect.height / 2;
      });
      nav.classList.toggle('is-wrapped', phone.matches && centers.length > 1 && Math.max(...centers) - Math.min(...centers) > 2);
    });
  };
  const schedule = () => { if (!frame) frame = requestAnimationFrame(measure); };
  const observer = new ResizeObserver(schedule);
  breadcrumbs.forEach(nav => observer.observe(nav));
  phone.addEventListener('change', schedule);
  document.fonts.ready.then(schedule);
  schedule();
</script>
