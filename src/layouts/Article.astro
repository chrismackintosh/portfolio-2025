---
import Base from './Base.astro';
import Masthead from '../components/Masthead.astro';
import ProductFooter from '../components/ProductFooter.astro';
interface Props {title:string; description:string; canonicalPath:string; eyebrow?:string; breadcrumbs?:{label:string;href?:string}[]}
const {title,description,canonicalPath,eyebrow='Portfolio',breadcrumbs=[{label:'Home',href:'/'},{label:Astro.props.title}]} = Astro.props;
---
<Base title={`${title} — Chris Mackintosh`} description={description} canonicalPath={canonicalPath}>
<a class="skip" href="#main">Skip to content</a>
<Masthead breadcrumbs={breadcrumbs} />
<main id="main" class="page article-page" tabindex="-1"><header class="article-intro"><p class="eyebrow">{eyebrow}</p><h1>{title}</h1><p class="article-description">{description}</p></header><div class="article-prose"><slot /></div><a class="return-link cm-inline-link" href="/#work"><span aria-hidden="true">←</span><span class="cm-intro-link-text">Back to selected work</span></a></main>
<ProductFooter />
</Base>
<style>
.article-page{max-width:880px}.article-intro{padding:64px 0 32px;border-bottom:1px solid var(--cm-line)}.eyebrow{font-size:13px;color:var(--cm-secondary)}h1{font-size:clamp(36px,6vw,64px);line-height:1.12;letter-spacing:-.04em;margin:16px 0 24px}.article-description{font-size:20px;line-height:1.5;color:var(--cm-secondary);max-width:38em}.article-prose{max-width:720px;font-size:17px;line-height:1.75}.article-prose :global(h2){font-size:26px;line-height:1.3;letter-spacing:-.02em;margin:42px 0 16px}.article-prose :global(p){margin:16px 0}.article-prose :global(li){margin:8px 0}.article-prose :global(a){text-decoration:underline;text-underline-offset:.2em}.article-prose :global(.archive-note){font-size:14px;color:var(--cm-secondary);border-left:2px solid var(--cm-line);padding-left:20px;margin-top:28px}.article-prose :global(blockquote){margin:24px 0;padding-left:24px;border-left:2px solid var(--cm-line)}.article-prose :global(code){font-size:.85em;overflow-wrap:anywhere}
@media(max-width:600px){.article-intro{padding-top:40px}.article-description{font-size:18px}}
</style>
